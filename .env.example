# 許願池通知信箱（收到意見後會寄到這個 Gmail）
VITE_WISH_NOTIFY_EMAIL=your.name@gmail.com

# Firebase（正式帳號雲端同步）
# 在 https://console.firebase.google.com 建立專案後，啟用 Authentication > Email/Password
# 與 Firestore，並把 Web App 設定貼到這裡。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
